<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpendWise">

        <!-- Login screen -->
        <activity
            android:name="com.alard.spendwise.LoginActivity"
            android:exported="false" />

        <!-- Register screen -->
        <activity
            android:name="com.alard.spendwise.RegisterActivity"
            android:exported="false" />

        <!-- Main screen opened after login  -->
        <activity
            android:name="com.alard.spendwise.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- First screen shown when the app starts -->
        <activity
            android:name="com.alard.spendwise.SplashActivity"
            android:exported="true">

            <!-- Sets SplashActivity as the launcher activity -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>