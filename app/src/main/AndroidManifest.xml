<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpendWise">

        <!-- Login screen -->
        <activity
            android:name="com.alard.spendwise.LoginActivity"
            android:exported="false" />

        <!-- Register screen -->
        <activity
            android:name="com.alard.spendwise.RegisterActivity"
            android:exported="false" />

        <!-- Forgot password screen -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />

        <!-- Main screen opened after login  -->
        <activity
            android:name="com.alard.spendwise.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Transaction entry: Income and Expense -->
        <activity
            android:name=".TransactionEntryActivity"
            android:exported="false" />

        <!-- Transaction history, details, edit and delete -->
        <activity
            android:name=".TransactionHistoryActivity"
            android:exported="false" />

        <!-- Income and Expense Breakdown screens -->
        <activity
            android:name=".BreakdownActivity"
            android:exported="false" />

        <!-- Settings, profile, camera/gallery and device features -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Income, expense reports and monthly charts -->
        <activity
            android:name=".ReportsActivity"
            android:exported="false" />



        <!-- First screen shown when the app starts -->
        <activity
            android:name="com.alard.spendwise.SessionRouterActivity"
            android:exported="true"
            android:theme="@style/Theme.SpendWise.Starting">

            <!-- Sets SplashActivity as the launcher activity -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>